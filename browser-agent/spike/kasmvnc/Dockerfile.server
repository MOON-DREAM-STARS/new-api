FROM debian:bookworm-slim

ARG KASMVNC_VERSION=1.5.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       chromium \
       curl \
       fonts-dejavu-core \
       fonts-noto-cjk \
       net-tools \
       novnc \
       procps \
       python3 \
       websockify \
       x11vnc \
       xvfb \
       xdotool \
    && rm -rf /var/lib/apt/lists/*

RUN curl -L --fail --silent --show-error \
       "https://github.com/kasmtech/KasmVNC/releases/download/v${KASMVNC_VERSION}/kasmvncserver_bookworm_${KASMVNC_VERSION}_amd64.deb" \
       -o /tmp/kasmvncserver.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/kasmvncserver.deb \
    && rm -f /tmp/kasmvncserver.deb \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/ /opt/spike/scripts/
COPY page/ /opt/spike/page/
RUN chmod 0755 /opt/spike/scripts/*.sh

ENV DISPLAY=:99 \
    HOME=/tmp/spike-home \
    XDG_CONFIG_HOME=/tmp/spike-home/config \
    XDG_CACHE_HOME=/tmp/spike-home/cache \
    XDG_DATA_HOME=/tmp/spike-home/data \
    XDG_RUNTIME_DIR=/tmp/spike-home/runtime \
    WW_SCREEN_WIDTH=1280 \
    WW_SCREEN_HEIGHT=720 \
    SPIKE_PAGE_URL=file:///opt/spike/page/index.html

WORKDIR /workspace
CMD ["/opt/spike/scripts/entrypoint-baseline.sh"]
